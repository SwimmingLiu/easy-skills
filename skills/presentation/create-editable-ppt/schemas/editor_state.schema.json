{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "base_revision", "revision", "project_status", "slide_order", "deleted_slides", "skipped_slides", "duplicated_slides", "text_overrides", "prop_overrides", "review_status"],
  "properties": {
    "schema_version": { "const": 1 },
    "base_revision": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "project_status": { "enum": ["drafting", "outline-review", "sample-review", "generating", "editing", "review", "exported"] },
    "slide_order": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "deleted_slides": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "skipped_slides": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "duplicated_slides": { "type": "array", "items": { "type": "object" } },
    "text_overrides": { "type": "object" },
    "prop_overrides": { "type": "object" },
    "review_status": { "type": "object", "additionalProperties": { "enum": ["pending", "pass", "revise", "skip"] } }
    ,"theme_override": {
      "type": ["object", "null"],
      "properties": { "family": { "type": "string" }, "variant": { "type": "string" } },
      "required": ["family", "variant"]
    }
  },
  "additionalProperties": false
}
