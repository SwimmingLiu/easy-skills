{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-skills.local/create-image-ppt/deck_spec.schema.json",
  "title": "Dual-mode AI presentation deck specification",
  "type": "object",
  "required": ["schema_version", "status", "title", "audience", "purpose", "central_message", "narrative", "language", "canvas", "output_mode", "theme", "slides"],
  "properties": {
    "schema_version": { "const": 2 },
    "status": { "const": "approved" },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "central_message": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "canvas": { "const": "16:9" },
    "presentation_mode": { "enum": ["image-first", "html-image-assisted"] },
    "output_mode": { "enum": ["full-slide-image", "html-image-assisted"] },
    "narrative": {
      "type": "object",
      "required": ["opening", "problem", "insight", "method", "action"],
      "properties": {
        "opening": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "insight": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["family"],
      "properties": {
        "family": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "required": ["id", "role", "content_kind", "purpose", "claim", "exact_text", "evidence", "media_brief", "transition", "visual_anchor_id", "continuity_group", "speaker_notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "role": { "enum": ["cover", "section", "statement", "image-hero", "two-column", "comparison", "process", "data", "quote", "closing"] },
        "content_kind": { "enum": ["claim", "image", "flow", "comparison", "table", "chart"] },
        "purpose": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "exact_text": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array" },
        "media_brief": { "type": "string", "minLength": 1 },
        "transition": { "type": "string", "minLength": 1 },
        "visual_anchor_id": { "type": "string", "minLength": 1 },
        "continuity_group": { "type": "string", "minLength": 1 },
        "speaker_notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
