{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image-first PPT outline draft",
  "type": "object",
  "required": ["schema_version", "status", "title", "audience", "purpose", "central_message", "narrative", "slides"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "draft" },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "central_message": { "type": "string", "minLength": 1 },
    "narrative": {
      "type": "object",
      "required": ["opening", "problem", "insight", "method", "action"],
      "additionalProperties": false,
      "properties": {
        "opening": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "insight": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "purpose", "claim", "exact_text", "evidence", "media_brief", "transition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["cover", "section", "statement", "image-hero", "two-column", "comparison", "process", "data", "quote", "closing"] },
          "purpose": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "exact_text": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence": { "type": "array" },
          "media_brief": { "type": "string", "minLength": 1 },
          "transition": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
