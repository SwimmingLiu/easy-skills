{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-skills.local/create-image-ppt/image_ppt_doc.schema.json",
  "title": "Offline image PPT document",
  "type": "object",
  "required": ["format", "version", "mode", "readonly", "title", "assets", "slides"],
  "properties": {
    "format": { "const": "image-ppt" },
    "version": { "const": 1 },
    "mode": { "const": "present" },
    "readonly": { "const": true },
    "title": { "type": "string" },
    "purpose": { "type": "string" },
    "central_message": { "type": "string" },
    "theme": { "type": "object" },
    "assets": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^data:[^;]+;base64," }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "image", "claim", "visual_anchor_id", "continuity_group", "transition"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "image": { "type": "string", "pattern": "^asset:" },
          "claim": { "type": "string" },
          "exact_text": { "type": "array", "items": { "type": "string" } },
          "speaker_notes": { "type": "string" },
          "visual_anchor_id": { "type": "string" },
          "continuity_group": { "type": "string" },
          "transition": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
